# Stripe Payment Link for the one-time Pro purchase. Leave unset to unlock everything (dev).
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_link
# Secret-ish code Stripe redirects back with: https://yourdomain.com/scan?unlock=<code>
VITE_UNLOCK_CODE=change-me-to-something-random
# Price label shown in the UI.
VITE_PRO_PRICE=$9
